    "@tailwindcss/vite": "^4.3.3",
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.0",
    "tailwindcss": "^4.3.3",
